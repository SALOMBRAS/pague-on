{
  "name": "pague-on-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do Pague-On",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "test": "node --test test/*.test.js",
    "test:integration": "DATABASE_URL=\"postgresql://pagueon_user:pagueon_local_dev_password@localhost:5432/pagueon?schema=public\" DIRECT_URL=\"postgresql://pagueon_user:pagueon_local_dev_password@localhost:5432/pagueon?schema=public\" node --test \"test/integration/*.test.js\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "puppeteer": "^25.8.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.15.0"
  }
}
