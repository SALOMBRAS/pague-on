generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PRO
}

enum UserRole {
  ADMIN
  MANAGER
  COLLECTOR
  CLIENT
}

enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum PaymentType {
  SINGLE
  INSTALLMENT
  RECURRING
}

enum DebtCategory {
  PRODUCT
  SERVICE
  LOAN
  RENT
  SUBSCRIPTION
  TRANSPORT
  UTILITIES
  OTHER
}

enum DebtStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  CANCELLED
}

enum Frequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum InterestType {
  NONE
  SIMPLE
  COMPOUND
  DAILY
  FIXED_FEE
}

enum ReminderType {
  PUSH
  WHATSAPP
  SMS
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum NotificationType {
  DEBT_DUE
  DEBT_OVERDUE
  PAYMENT_RECEIVED
  STOCK_LOW
  BUDGET_ALERT
  BUDGET_EXCEEDED
  GOAL_REACHED
  WEEKLY_DIGEST
  MONTHLY_DIGEST
  RULE_APPLIED
  SYSTEM
}

enum RuleTriggerLogic {
  ALL
  ANY
}

enum RuleTriggerType {
  DESCRIPTION_CONTAINS
  DESCRIPTION_STARTS_WITH
  DESCRIPTION_IS
  AMOUNT_EXACTLY
  AMOUNT_GREATER_THAN
  AMOUNT_LESS_THAN
  COUNTERPARTY_IS
  COUNTERPARTY_CONTAINS
  CATEGORY_IS
  TYPE_IS
}

enum RuleOperator {
  EQUALS
  CONTAINS
  STARTS_WITH
  GREATER_THAN
  LESS_THAN
}

enum RuleActionType {
  SET_CATEGORY
  SET_TYPE
  SET_PAYMENT_TYPE
  ADD_TAG
  SET_REMINDER
  SEND_NOTIFICATION
  SET_COUNTERPARTY
}

enum SecurityChallengeType {
  REGISTRATION
  AUTHENTICATION
}

enum AssetType {
  CASH
  INVESTMENT_STOCK
  INVESTMENT_CRYPTO
  INVESTMENT_FIXED
  PROPERTY
  VEHICLE
  OTHER
}

enum BankTransactionStatus {
  PENDING
  MATCHED
  CONFIRMED
  IGNORED
  CREATED
}

enum SaleStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum FinancialAccountType {
  CASH
  BANK
  PAYMENT_ACCOUNT
  DIGITAL_WALLET
  LOAN_CAPITAL
  OTHER
}

enum FinancialMovementType {
  OPENING_BALANCE
  LOAN_DISBURSEMENT
  PAYMENT_RECEIVED
  EXPENSE_PAID
  TRANSFER_OUT
  TRANSFER_IN
  REVERSAL
  ADJUSTMENT
}

enum CustomerPersonType {
  INDIVIDUAL
  LEGAL
}

enum CustomerStatus {
  PENDING_REVIEW
  APPROVED
  INACTIVE
  REJECTED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionBase {
  PRINCIPAL
  INTEREST
  PENALTY
  TOTAL
}

enum CollectorContactType {
  CALL
  WHATSAPP
  SMS
  VISIT
  PAYMENT_PROMISE
  NOTE
}

enum CollectorCommissionStatus {
  ACTIVE
  REVERSED
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String
  email               String         @unique
  password            String
  avatar              String?
  phone               String?
  phoneNormalized     String?        @unique
  role                UserRole       @default(ADMIN)
  workspaceOwnerId    String?        @db.Uuid
  plan                Plan           @default(FREE)
  currency            String         @default("BRL")
  theme               String         @default("dark")
  notificationEnabled Boolean        @default(true)
  reminderDefaultTime Int?           @default(1440)
  dueReminderDays    Int             @default(3)
  budgetAlerts       Boolean         @default(true)
  stockAlerts        Boolean         @default(true)
  weeklyDigest       Boolean         @default(true)
  monthlyDigest      Boolean         @default(false)
  notificationSound  String          @default("DEFAULT")
  defaultMessage      String?
  duplicateSensitivity Int          @default(70)
  sessionVersion      Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  debts               Debt[]
  products            Product[]
  purchases           Purchase[]
  customers           Customer[]
  customerClassifications CustomerClassification[]
  customerDocuments CustomerDocument[]
  customerConsents CustomerConsent[]
  customerRegistrationInvites CustomerRegistrationInvite[]
  sales               Sale[]
  reminders           Reminder[]
  notifications       Notification[]
  cashFlows           CashFlow[]
  rules               Rule[]
  ruleExecutions      RuleExecution[]
  security            UserSecurity?
  webauthnCredentials WebAuthnCredential[]
  backups             BackupSnapshot[]
  assets              Asset[]
  netWorthSnapshots   NetWorthSnapshot[]
  bankStatements      BankStatement[]
  bankTransactions    BankTransaction[]
  budgets             Budget[]
  pushSubscriptions   PushSubscription[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  workspaceOwner      User?          @relation("WorkspaceMembers", fields: [workspaceOwnerId], references: [id], onDelete: Cascade)
  workspaceMembers    User[]         @relation("WorkspaceMembers")
  clientProfile       Customer?      @relation("ClientPortal")
  assignedCustomers   Customer[]     @relation("CollectorAssignments")
  approvedCustomers   Customer[]     @relation("CustomerApprovals")
  auditEvents         AuditLog[]     @relation("AuditActor")
  workspaceAuditEvents AuditLog[]    @relation("AuditWorkspace")
  goals               Goal[]
  goalTransactions    GoalTransaction[]
  syncLogs            SyncLog[]
  financialAccounts   FinancialAccount[]
  financialMovements  FinancialMovement[]
  financialCashClosings FinancialCashClosing[]
  collectedFinancialMovements FinancialMovement[] @relation("FinancialMovementCollector")
  responsibleFinancialMovements FinancialMovement[] @relation("FinancialMovementResponsible")
  collectorProfile    CollectorProfile?
  collectorContacts   CollectorContact[] @relation("CollectorContactActor")
  collectorCommissions CollectorCommission[]
}

model FinancialAccount {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @db.Uuid
  name                  String               @db.VarChar(120)
  type                  FinancialAccountType @default(CASH)
  institution           String?              @db.VarChar(160)
  openingBalance        Decimal              @default(0) @db.Decimal(12, 2)
  isActive              Boolean              @default(true)
  includeInAvailability Boolean              @default(true)
  notes                 String?              @db.VarChar(1000)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements             FinancialMovement[]
  closings              FinancialCashClosing[]

  @@index([userId, isActive, includeInAvailability])
}

model FinancialMovement {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  accountId   String                @db.Uuid
  type        FinancialMovementType
  amount      Decimal               @db.Decimal(12, 2)
  occurredAt  DateTime
  referenceId String?               @db.VarChar(120)
  description String?               @db.VarChar(500)
  category    String?               @db.VarChar(80)
  origin      String?               @db.VarChar(80)
  paymentMethod String?             @db.VarChar(40)
  customerId  String?               @db.Uuid
  debtId      String?               @db.Uuid
  collectorId String?               @db.Uuid
  responsibleUserId String?         @db.Uuid
  operationId String?               @db.Uuid
  reversalOfId String?              @db.Uuid
  isConfirmed Boolean               @default(true)
  principal   Decimal               @default(0) @db.Decimal(12, 2)
  interest    Decimal               @default(0) @db.Decimal(12, 2)
  penalty     Decimal               @default(0) @db.Decimal(12, 2)
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customer    Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  debt        Debt?                 @relation(fields: [debtId], references: [id], onDelete: SetNull)
  collector   User?                 @relation("FinancialMovementCollector", fields: [collectorId], references: [id], onDelete: SetNull)
  responsibleUser User?             @relation("FinancialMovementResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  reversalOf  FinancialMovement?    @relation("FinancialMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals   FinancialMovement[]   @relation("FinancialMovementReversal")

  @@unique([userId, referenceId])
  @@index([userId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([customerId, occurredAt])
  @@index([debtId, occurredAt])
  @@index([operationId])
}

model FinancialCashClosing {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  accountId         String   @db.Uuid
  closedThrough     DateTime
  ledgerBalance     Decimal  @db.Decimal(12, 2)
  countedBalance    Decimal  @db.Decimal(12, 2)
  difference        Decimal  @db.Decimal(12, 2)
  notes             String?  @db.VarChar(1000)
  responsibleUserId String?  @db.Uuid
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, closedThrough])
  @@index([userId, accountId, closedThrough])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceOwnerId String?  @db.Uuid
  actorId          String?  @db.Uuid
  eventType        String   @db.VarChar(80)
  actorEmailHash   String?  @db.VarChar(64)
  targetId         String?  @db.Uuid
  targetType       String?  @db.VarChar(80)
  targetEmailHash  String?  @db.VarChar(64)
  payload          Json?
  ipAddress        String?  @db.VarChar(64)
  userAgent        String?  @db.VarChar(512)
  legalHold        Boolean  @default(false)
  createdAt        DateTime @default(now())
  actor            User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspaceOwner   User?    @relation("AuditWorkspace", fields: [workspaceOwnerId], references: [id], onDelete: SetNull)

  @@index([workspaceOwnerId, createdAt])
  @@index([actorId, createdAt])
  @@index([legalHold, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Debt {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @db.Uuid
  type              DebtType
  paymentType       PaymentType
  description       String
  category          DebtCategory
  counterparty      String
  counterpartyPhone String?
  customerId        String?            @db.Uuid
  saleId            String?            @unique @db.Uuid
  totalAmount       Decimal            @db.Decimal(12, 2)
  currency          String             @default("BRL") @db.VarChar(3)
  originalAmount    Decimal?           @db.Decimal(12, 2)
  exchangeRate      Decimal            @default(1) @db.Decimal(16, 8)
  paidAmount        Decimal            @default(0) @db.Decimal(12, 2)
  installmentAmount Decimal?           @db.Decimal(12, 2)
  totalInstallments Int?
  paidInstallments  Int                @default(0)
  frequency         Frequency?
  startDate         DateTime
  dueDate           DateTime
  endDate           DateTime?
  repeatCount       Int?
  status            DebtStatus         @default(PENDING)
  isActive          Boolean            @default(true)
  paidAt            DateTime?
  productId         String?            @db.Uuid
  quantity          Int?
  tags              String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale              Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  installments      Installment[]
  recurringPayments RecurringPayment[]
  reminders         Reminder[]
  ruleExecutions    RuleExecution[]
  bankTransactions BankTransaction[]
  financialMovements FinancialMovement[]
  collectorContacts CollectorContact[]
  collectorCommissions CollectorCommission[]

  @@index([userId, status, dueDate])
  @@index([productId])
  @@index([customerId])
}

model Installment {
  id                      String        @id @default(uuid()) @db.Uuid
  debtId                  String        @db.Uuid
  number                  Int
  amount                  Decimal       @db.Decimal(12, 2)
  interestAmount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal       @default(0) @db.Decimal(12, 2)
  dueDate                 DateTime
  paidAt                  DateTime?
  paidAmount              Decimal?      @db.Decimal(12, 2)
  paymentMethod           String?
  note                    String?
  status                  PaymentStatus @default(PENDING)
  daysOverdue             Int           @default(0)
  interestRateAtCreation  Decimal       @default(0) @db.Decimal(7, 4)
  lastReminderSent        DateTime?
  reminderCount           Int           @default(0)
  createdAt               DateTime      @default(now())
  debt                    Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  collectorContacts       CollectorContact[]
  collectorCommissions    CollectorCommission[]

  @@unique([debtId, number])
  @@index([debtId, status, dueDate])
}

model RecurringPayment {
  id        String        @id @default(uuid()) @db.Uuid
  debtId    String        @db.Uuid
  period    String
  dueDate   DateTime
  paidAt    DateTime?
  amount    Decimal?      @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  debt      Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@unique([debtId, period])
  @@index([debtId, status, dueDate])
}

model Product {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  name          String
  category      String?
  costPrice     Decimal    @db.Decimal(12, 2)
  sellingPrice  Decimal    @db.Decimal(12, 2)
  profitMargin  Decimal    @db.Decimal(7, 2)
  stockQuantity Int        @default(0)
  minStockAlert Int?       @default(5)
  image         String?
  description   String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases     Purchase[]
  debts         Debt[]
  saleItems     SaleItem[]

  @@index([userId, isActive])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  collectorId String? @db.Uuid
  portalUserId String? @unique @db.Uuid
  name      String
  nickname  String?
  phone     String?
  email     String?
  cpfCnpj   String?
  personType CustomerPersonType @default(INDIVIDUAL)
  documentNumber String?
  birthOrIncorporationDate DateTime?
  category String?
  professionOrActivity String?
  declaredIncome Decimal? @db.Decimal(12, 2)
  creditLimit Decimal? @db.Decimal(12, 2)
  approvedInterestRate Decimal? @db.Decimal(7, 4)
  whatsapp String?
  zipCode String?
  street String?
  streetNumber String?
  addressComplement String?
  neighborhood String?
  city String?
  state String?
  classificationId String? @db.Uuid
  status CustomerStatus @default(APPROVED)
  approvedAt DateTime?
  approvedById String? @db.Uuid
  address   String?
  avatar    String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collector User?    @relation("CollectorAssignments", fields: [collectorId], references: [id], onDelete: SetNull)
  portalUser User?   @relation("ClientPortal", fields: [portalUserId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("CustomerApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  classification CustomerClassification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  debts     Debt[]
  sales     Sale[]
  financialMovements FinancialMovement[]
  documents CustomerDocument[]
  consents CustomerConsent[]
  registrationInvites CustomerRegistrationInvite[]
  collectorContacts CollectorContact[]
  collectorCommissions CollectorCommission[]

  @@index([userId, isActive, name])
  @@index([collectorId, isActive])
  @@index([userId, status, classificationId])
}

model CollectorProfile {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @db.Uuid
  documentNumber String?        @db.VarChar(40)
  whatsapp       String?        @db.VarChar(30)
  isActive       Boolean        @default(true)
  commissionType CommissionType @default(PERCENTAGE)
  commissionRate Decimal        @default(0) @db.Decimal(7, 4)
  commissionBase CommissionBase @default(TOTAL)
  permissions    Json?
  notes          String?        @db.VarChar(2000)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model CollectorContact {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  collectorId   String               @db.Uuid
  customerId    String               @db.Uuid
  debtId        String?              @db.Uuid
  installmentId String?              @db.Uuid
  type          CollectorContactType
  note          String?              @db.VarChar(2000)
  promisedDate  DateTime?
  promisedAmount Decimal?            @db.Decimal(12, 2)
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  collector     User                 @relation("CollectorContactActor", fields: [collectorId], references: [id], onDelete: Restrict)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  debt          Debt?                @relation(fields: [debtId], references: [id], onDelete: SetNull)
  installment   Installment?         @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([userId, collectorId, createdAt])
  @@index([customerId, createdAt])
  @@index([promisedDate])
}

model CollectorCommission {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @db.Uuid
  collectorId      String                   @db.Uuid
  customerId       String                   @db.Uuid
  debtId           String                   @db.Uuid
  installmentId    String?                  @db.Uuid
  paymentAmount    Decimal                  @db.Decimal(12, 2)
  baseAmount       Decimal                  @db.Decimal(12, 2)
  commissionAmount Decimal                  @db.Decimal(12, 2)
  commissionType   CommissionType
  commissionRate   Decimal                  @db.Decimal(7, 4)
  commissionBase   CommissionBase
  status           CollectorCommissionStatus @default(ACTIVE)
  reversedAt       DateTime?
  reversalReason   String?                  @db.VarChar(500)
  createdAt        DateTime                 @default(now())
  collector        User                     @relation(fields: [collectorId], references: [id], onDelete: Restrict)
  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  debt             Debt                     @relation(fields: [debtId], references: [id], onDelete: Restrict)
  installment      Installment?             @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@index([userId, collectorId, createdAt])
  @@index([installmentId, status])
  @@index([customerId, debtId])
}

model CustomerClassification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String @db.VarChar(100)
  criteria Json?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([userId, name])
  @@index([userId, isActive])
}

model CustomerDocument {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  customerId String @db.Uuid
  fileName String @db.VarChar(255)
  storagePath String @db.VarChar(500)
  mimeType String @db.VarChar(120)
  uploadedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, uploadedAt])
}

model CustomerConsent {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  customerId String @db.Uuid
  purpose String @db.VarChar(80)
  granted Boolean
  source String @db.VarChar(80)
  grantedAt DateTime @default(now())
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose, grantedAt])
}

model CustomerRegistrationInvite {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  customerId String @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt DateTime?
  submittedAt DateTime?
  submittedData Json?
  createdById String? @db.Uuid
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model Sale {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  customerId  String?    @db.Uuid
  totalAmount Decimal    @db.Decimal(12, 2)
  paidAmount  Decimal    @default(0) @db.Decimal(12, 2)
  discount    Decimal    @default(0) @db.Decimal(12, 2)
  interestRate Decimal  @default(0) @db.Decimal(7, 4)
  interestType InterestType @default(NONE)
  paymentType PaymentType @default(SINGLE)
  totalInstallments Int?
  installmentAmount Decimal? @db.Decimal(12, 2)
  frequency Frequency?
  firstDueDate DateTime?
  remainingAmount Decimal @default(0) @db.Decimal(12, 2)
  totalInterest Decimal @default(0) @db.Decimal(12, 2)
  description String?
  status      SaleStatus @default(PENDING)
  notes       String?
  soldAt      DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  debt        Debt?

  @@index([userId, soldAt])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @db.Uuid
  productId String  @db.Uuid
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  unitCost  Decimal  @db.Decimal(12, 2)
  totalCost Decimal  @db.Decimal(12, 2)
  supplier  String?
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([productId])
}

model Reminder {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  debtId      String?        @db.Uuid
  type        ReminderType   @default(PUSH)
  scheduledAt DateTime
  sentAt      DateTime?
  message     String?
  status      ReminderStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt        Debt?          @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([userId, status, scheduledAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  body      String
  type      NotificationType
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model PushSubscription {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CashFlow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  date      DateTime @db.Date
  totalIn   Decimal  @default(0) @db.Decimal(12, 2)
  totalOut  Decimal  @default(0) @db.Decimal(12, 2)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Rule {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  name         String
  order        Int              @default(0)
  isActive     Boolean          @default(true)
  triggerLogic RuleTriggerLogic @default(ALL)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggers     RuleTrigger[]
  actions      RuleAction[]
  executions   RuleExecution[]

  @@index([userId, isActive, order])
}

model RuleTrigger {
  id       String          @id @default(uuid()) @db.Uuid
  ruleId   String          @db.Uuid
  type     RuleTriggerType
  value    String
  operator RuleOperator    @default(EQUALS)
  rule     Rule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model RuleAction {
  id     String         @id @default(uuid()) @db.Uuid
  ruleId String         @db.Uuid
  type   RuleActionType
  value  String
  rule   Rule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model RuleExecution {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  ruleId         String   @db.Uuid
  debtId         String?  @db.Uuid
  actionsApplied Json
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule           Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  debt           Debt?    @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([debtId])
}

model UserSecurity {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @unique @db.Uuid
  biometricEnabled      Boolean               @default(false)
  pinHash               String?
  pinSalt               String?
  lockTimeout           Int                   @default(5)
  hideValues            Boolean               @default(false)
  pinAttempts           Int                   @default(0)
  pinLockedUntil        DateTime?
  webauthnChallenge     String?
  challengeType         SecurityChallengeType?
  challengeExpiresAt    DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebAuthnCredential {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  credentialId  String   @unique
  publicKey     Bytes
  counter       BigInt   @default(0)
  transports    String[] @default([])
  deviceType    String?
  backedUp      Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BackupSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  version     String
  exportedAt  DateTime
  sizeBytes   Int
  iv          String
  authTag     String
  ciphertext  String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  type        AssetType
  value       Decimal   @db.Decimal(12, 2)
  currency    String    @default("BRL")
  isLiquid    Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model NetWorthSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  date        DateTime @db.Date
  netWorth    Decimal  @db.Decimal(12, 2)
  totalAssets Decimal  @db.Decimal(12, 2)
  liabilities Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model BankStatement {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  fileName    String
  accountName String?
  importedAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([userId, importedAt])
}

model BankTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  statementId     String                @db.Uuid
  externalId      String?
  fingerprint     String
  date            DateTime              @db.Date
  description     String
  amount          Decimal               @db.Decimal(12, 2)
  balance         Decimal?              @db.Decimal(12, 2)
  status          BankTransactionStatus @default(PENDING)
  matchedDebtId   String?               @db.Uuid
  matchConfidence Int?
  confirmedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement       BankStatement         @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedDebt     Debt?                 @relation(fields: [matchedDebtId], references: [id], onDelete: SetNull)

  @@unique([userId, fingerprint])
  @@index([userId, statementId, status])
  @@index([matchedDebtId])
}

model Budget {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  category    DebtCategory
  month       Int
  year        Int
  limitAmount Decimal      @db.Decimal(12, 2)
  spentAmount Decimal      @default(0) @db.Decimal(12, 2)
  rollover    Boolean      @default(false)
  alertAt     Int          @default(80)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@index([userId, year, month])
}

model Currency {
  code      String   @id @db.VarChar(3)
  name      String
  symbol    String
  rateToBRL Decimal  @default(1) @db.Decimal(16, 8)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum GoalTransactionType {
  DEPOSIT
  WITHDRAW
}

model Goal {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  name          String
  icon          String?
  targetAmount  Decimal           @db.Decimal(12, 2)
  currentAmount Decimal           @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?         @db.Date
  color         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  GoalTransaction[]

  @@index([userId])
}

model GoalTransaction {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  goalId    String            @db.Uuid
  type      GoalTransactionType
  amount    Decimal           @db.Decimal(12, 2)
  note      String?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, goalId])
}

model SyncLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  entity    String
  recordId  String
  op        String
  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entity, appliedAt])
}
