{
  "version": 2,
  "regions": ["gru1"],
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 1024 } }
  ],
  "routes": [
    {
      "src": "/(.*)\\.(css|js|svg|png|jpg|jpeg|webp|ico|woff|woff2)",
      "headers": { "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" },
      "dest": "api/index.js"
    },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
