{
  "version": 2,
  "regions": ["gru1"],
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 1024 } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(?!sw\\.js$)(.*)\\.(css|js|svg|png|jpg|jpeg|webp|ico|woff|woff2)",
      "headers": { "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" },
      "continue": true
    },
    { "src": "/$", "dest": "api/index.js" },
    { "src": "/app$", "dest": "api/index.js" },
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/uploads/(.*)", "dest": "api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
