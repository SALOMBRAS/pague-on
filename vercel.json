{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/app", "dest": "public/index.html" },
    { "src": "/health", "dest": "api/index.js" },
    { "src": "/uploads/(.*)", "dest": "public/uploads/$1" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
