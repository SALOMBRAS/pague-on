{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "maxDuration": 30, "memory": 1024 } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/app", "dest": "public/index.html" },
    { "src": "/health", "dest": "api/index.js" },
    { "src": "/uploads/(.*)", "dest": "public/uploads/$1" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
